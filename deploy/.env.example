# Copy to /opt/armorywiki/.env on the VPS (never commit the real one). PLAN.md Phase 6.
SITE_DOMAIN=armorywiki.example.org
IMAGE_TAG=latest

POSTGRES_USER=armorywiki
# Letters and digits only (openssl rand -hex 24): it is pasted into a connection string, where ";" would break it.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=armorywiki

# The admin account, created on first start. 12+ characters with upper case, a digit and a symbol.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me

# Shared by the API and the frontend: openssl rand -hex 32
REVALIDATE_SECRET=change-me

# Only for import-fw-videos.
YOUTUBE_API_KEY=
