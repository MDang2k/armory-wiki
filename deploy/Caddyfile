# PLAN.md Phase 6. SITE_DOMAIN comes from .env; Caddy gets and renews the certificate itself
# ("localhost" gets one from Caddy's own local CA, for trying the stack out).
{$SITE_DOMAIN} {
	encode zstd gzip

	# The API, including /api/revalidate, which therefore never reaches Next from outside: the API calls Next
	# inside the Docker network.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Image files, named by content hash: they never change, so browsers may keep them for a year.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
