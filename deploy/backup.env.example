# Copy to /opt/armorywiki/backup.env (chmod 600; never commit it). Used by backup.sh and restore-check.sh.
# A Backblaze B2 bucket (private) and an application key limited to it.
RESTIC_REPOSITORY=b2:your-bucket-name:armorywiki
# Encrypts the backups. Keep a copy outside the server (a password manager): without it nothing can be restored.
RESTIC_PASSWORD=change-me
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Optional: a healthchecks.io (or similar) ping URL. Each run pings it, or <url>/fail on error; a missed night alerts you.
HEALTHCHECK_URL=
